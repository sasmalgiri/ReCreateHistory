# ── Kalsmritikosh web (hosted SaaS) configuration ──
# Copy to .env (local) or set as environment variables on your host.

# HTTP port the server listens on.
PORT=8787

# REQUIRED in production: secret used to sign session JWTs. Generate a long
# random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where per-user ledgers + uploads are stored. Mount a PERSISTENT disk here in
# production (Render/Railway/Fly volume) so data survives restarts/deploys.
DATA_DIR=data

# Max upload size per file (bytes). Default 50 MB.
# MAX_UPLOAD_BYTES=52428800

# ── AI engine: "both" — local Ollama if reachable, else the cloud key below ──

# Ollama (optional). If the server can reach an Ollama instance, it's used first
# (more private). Leave default if none — the cloud key then handles LLM work.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED=nomic-embed-text

# Cloud fallback (recommended for a real hosted deployment). Set ONE of these.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# CLOUD_MODEL=claude-sonnet-5     # or gpt-4o-mini for OpenAI
